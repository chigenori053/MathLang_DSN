package mathlang_dsn

module main {
  import mathlang_dsn.Model
  import mathlang_dsn.Polynomial
  import mathlang_dsn.Knowledge
  import mathlang_dsn.JuniorHigh
  import mathlang_dsn.Japanese_semantic_adapter
  import mathlang_dsn.Memory_codec_f4
  import mathlang_dsn.Math_adapter_stage2a
  import mathlang_dsn.Code_adapter_stage2a

  calculation SelfCheck {
    let kinds = [0, 0, 2]
    let values = [2, 3, 0]
    let lefts = [-1, -1, 0]
    let rights = [-1, -1, 1]
    let sum = Model::Evaluate(kinds, values, lefts, rights)
    let equation = Model::Solve(2, 6, 0, 12)
    let two_moves = Model::Solve(2, 6, 3, 10)
    let contradiction = Model::Solve(1, 1, 1, 2)
    let identity = Model::Solve(1, 1, 1, 1)
    let accepted = Model::AssessEquations(2, 6, 0, 12, 1, 0, 0, 3)
    let rejected = Model::AssessEquations(2, 6, 0, 12, 1, 0, 0, 4)
    result = sum.valid && sum.a == 0 && sum.b == 5 && equation.status == "SOLVED" && equation.numerator == 3 && equation.denominator == 1 && two_moves.status == "SOLVED" && two_moves.steps.length == 2 && contradiction.status == "CONTRADICTION" && identity.status == "INFINITE_SOLUTIONS" && accepted == "VALID" && rejected == "INVALID"
  }

  calculation PolynomialSelfCheck {
    let half = Polynomial::PolyEvaluate([0, 0, 5], [1, 2, 0], [-1, -1, 0], [-1, -1, 1])
    let square = Polynomial::PolyEvaluate([1, 0, 2, 6], [0, 1, 0, 2], [-1, -1, 0, 2], [-1, -1, 1, -1])
    let derivative = Polynomial::PolyDifferentiate(square)
    let integral = Polynomial::PolyIntegrate(derivative)
    result = half.valid && half.coefficients[0] == 1 && half.denominator == 2 && square.valid && square.coefficients[2] == 1 && derivative.coefficients[1] == 2 && integral.coefficients[2] == 1
  }

  calculation KnowledgeSelfCheck {
    let catalog = Knowledge::KCatalog()
    let active = Knowledge::KActiveEquationRus(2, 6, 3, 10)
    let equation = Model::Solve(2, 6, 3, 10)
    let polynomial = Polynomial::PolyEvaluate([1, 0, 2, 6], [0, 1, 0, 2], [-1, -1, 0, 2], [-1, -1, 1, -1])
    let assessment = Polynomial::PolyCheckExpressions(polynomial, polynomial)
    result = catalog.length == 27 && Knowledge::KToRu(catalog[0]).knowledge_id == "EQ_MOVE_RIGHT_VARIABLE" && active.members.length == 2 && Knowledge::KActiveOperationRus(16).name == "PolynomialRUS" && equation.ruos.length == equation.steps.length && equation.ruos.length == 2 && equation.ruos[0].knowledge_id == "EQ_MOVE_RIGHT_VARIABLE" && equation.ruos[0].source_ru == 1 && equation.ruos[0].source_rus == active.id && equation.ruos[0].state_before == equation.steps[0].before && equation.ruos[0].state_after == equation.steps[0].after && equation.ruos[1].knowledge_id == "EQ_MOVE_LEFT_CONSTANT" && polynomial.ruos.length == 2 && polynomial.ruos[1].knowledge_id == "POLY_POWER_BOUNDED" && assessment.status == "VALID" && assessment.knowledge_id == "POLY_EXPRESSION_EQUIVALENCE"
  }

  calculation JuniorHighSelfCheck {
    let factors = JuniorHigh::JPrimeFactors(360)
    let radical = JuniorHigh::JSimplifySqrt(72)
    let quadratic = JuniorHigh::JSolveQuadratic(1, 0, -2)
    let system = JuniorHigh::JSolveSystem(1, 1, 5, 1, -1, 1)
    let function_value = JuniorHigh::JFunctionValue([1, 2, 1, 0, 0, 0], 1, 2, 1)
    let polygon = JuniorHigh::JPolygonAngleSum(5)
    let triangle = JuniorHigh::JHypotenuse(3, 4)
    let data = JuniorHigh::JDataSummary([1, 2, 3, 4, 5, 6])
    let probability = JuniorHigh::JClassicalProbability(2, 6)
    let inverse = JuniorHigh::JInverseProportion(6, 1, 2, 1)
    let similarity = JuniorHigh::JSimilarityRatios(2, 3)
    let frequency = JuniorHigh::JRelativeFrequency(3, 12)
    let circle = JuniorHigh::JCircleAngle(90)
    result = factors.factors.length == 6 && radical.outside == 6 && radical.inside == 2 && quadratic.status == "SOLVED" && quadratic.roots.length == 2 && quadratic.roots[0].radicand == 2 && system.x.numerator == 3 && system.y.numerator == 2 && function_value.value.numerator == 9 && polygon.angle_sum == 540 && triangle.length_outside == 5 && data.median.numerator == 7 && data.median.denominator == 2 && probability.value.numerator == 1 && probability.value.denominator == 3 && inverse.value.numerator == 3 && similarity.area_ratio.numerator == 4 && similarity.volume_ratio.denominator == 27 && frequency.value.denominator == 4 && circle.value.numerator == 45
  }

  calculation MirpSelfCheck {
    let greater = Model::CompareIntegers(7, 6, 2)
    let unknown_rule = Model::CompareIntegers(7, 6, 9)
    result = greater.status == "APPLIED" && greater.value && greater.ruo.source_ru == 34 && greater.ruo.source_rus == "ComparisonRUS" && unknown_rule.status == "UNSUPPORTED"
  }

  calculation MirpImportedAdaptersSelfCheck {
    let semantic = Japanese_semantic_adapter::AdaptJapaneseSemantic("太郎は学生である。")
    let unit = Memory_codec_f4::New("memory-1", ["RU"], ["RUS"], ["RUO"], [], [], "goal", "KNOWN", "", "v1", "source", 0, 0)
    let packet = Memory_codec_f4::Encode(unit, "DICTIONARY")
    let saved = Memory_codec_f4::Store(Memory_codec_f4::EmptySpace(), packet)
    let restored = Memory_codec_f4::Retrieve(saved, "memory-1")
    let math = Math_adapter_stage2a::AdaptMath("x:=5")
    let code = Code_adapter_stage2a::AdaptCode("if(y>6){result=y;}")
    result = semantic.status == "RESOLVED" && semantic.primitives.length > 0 && restored.valid && restored.unit.memory_id == "memory-1" && math.assignments.length == 1 && code.conditions.length == 1
  }
}
