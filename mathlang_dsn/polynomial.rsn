package mathlang_dsn

// Exact bounded rational polynomials of degree at most five.
module Polynomial {
  import mathlang_dsn.Model
  import mathlang_dsn.Knowledge

  struct Poly {
    valid: bool
    coefficients: [int]
    denominator: int
    reason: string
    knowledge_ids: [string]
    knowledge_sources: [string]
    ruos: [PolyRuo]
  }

  struct PolyRuo {
    id: int
    source_ru: int
    source_rus: string
    knowledge_id: string
    source: string
    before_left: [int]
    before_left_denominator: int
    before_right: [int]
    before_right_denominator: int
    after: [int]
    after_denominator: int
    validation: string
  }

  struct Assessment {
    status: string
    knowledge_id: string
    source: string
    active_rus: string
    ruo: AssessmentRuo
  }

  struct AssessmentRuo {
    id: int
    source_ru: int
    source_rus: string
    knowledge_id: string
    source: string
    validation: string
  }

  fn Abs(value: int) -> int {
    if value < 0 {
      return 0 - value
    }
    return value
  }

  fn Gcd(left: int, right: int) -> int {
    let a = Abs(left)
    let b = Abs(right)
    while b != 0 {
      let remainder = a % b
      a = b
      b = remainder
    }
    return a
  }

  fn DivideExact(numerator: int, denominator: int) -> int {
    let remaining = Abs(numerator)
    let divisor = Abs(denominator)
    let quotient = 0
    while remaining >= divisor {
      let chunk = divisor
      let count = 1
      while chunk <= remaining - chunk {
        chunk = chunk + chunk
        count = count + count
      }
      remaining = remaining - chunk
      quotient = quotient + count
    }
    if (numerator < 0 && denominator > 0) || (numerator > 0 && denominator < 0) {
      return 0 - quotient
    }
    return quotient
  }

  fn Zeros() -> [int] {
    return [0, 0, 0, 0, 0, 0]
  }

  fn Invalid(reason: string) -> Poly {
    return Poly { valid: false, coefficients: Zeros(), denominator: 1, reason: reason, knowledge_ids: [], knowledge_sources: [], ruos: [] }
  }

  fn Value(numbers: [int], divisor: int) -> Poly {
    if numbers.length != 6 || divisor == 0 {
      return Invalid("INVALID_INPUT")
    }
    let denominator = divisor
    let coefficients = numbers
    if denominator < 0 {
      denominator = 0 - denominator
      let flipped = []
      for number in coefficients {
        flipped = array.append(flipped, 0 - number)
      }
      coefficients = flipped
    }
    let common = denominator
    for number in coefficients {
      common = Gcd(common, number)
    }
    let reduced = []
    for number in coefficients {
      reduced = array.append(reduced, DivideExact(number, common))
    }
    denominator = DivideExact(denominator, common)
    if denominator > 1000000 {
      return Invalid("RESOURCE_LIMIT")
    }
    for number in reduced {
      if Abs(number) > 1000000 {
        return Invalid("RESOURCE_LIMIT")
      }
    }
    return Poly { valid: true, coefficients: reduced, denominator: denominator, reason: "", knowledge_ids: [], knowledge_sources: [], ruos: [] }
  }

  fn Attach(value: Poly, ids: [string], sources: [string], history: [PolyRuo], rule: int) -> Poly {
    if !value.valid {
      return value
    }
    let ru = Knowledge::KRuByRule(rule)
    if ru.id == 0 {
      return Invalid("UNKNOWN_KNOWLEDGE")
    }
    return Poly { valid: true, coefficients: value.coefficients, denominator: value.denominator, reason: "", knowledge_ids: array.append(ids, ru.knowledge_id), knowledge_sources: array.append(sources, ru.source), ruos: history }
  }

  fn Transition(value: Poly, left: Poly, right: Poly, history: [PolyRuo], rule: int) -> Poly {
    if !value.valid {
      return value
    }
    let ru = Knowledge::KRuByRule(rule)
    let active = Knowledge::KActiveOperationRus(rule)
    let event = PolyRuo { id: history.length + 1, source_ru: ru.id, source_rus: active.name, knowledge_id: ru.knowledge_id, source: ru.source, before_left: left.coefficients, before_left_denominator: left.denominator, before_right: right.coefficients, before_right_denominator: right.denominator, after: value.coefficients, after_denominator: value.denominator, validation: "APPLIED" }
    return Poly { valid: value.valid, coefficients: value.coefficients, denominator: value.denominator, reason: value.reason, knowledge_ids: value.knowledge_ids, knowledge_sources: value.knowledge_sources, ruos: array.append(history, event) }
  }

  fn Renumber(value: Poly) -> Poly {
    let ordered = []
    for event in value.ruos {
      let item = PolyRuo { id: ordered.length + 1, source_ru: event.source_ru, source_rus: event.source_rus, knowledge_id: event.knowledge_id, source: event.source, before_left: event.before_left, before_left_denominator: event.before_left_denominator, before_right: event.before_right, before_right_denominator: event.before_right_denominator, after: event.after, after_denominator: event.after_denominator, validation: event.validation }
      ordered = array.append(ordered, item)
    }
    return Poly { valid: value.valid, coefficients: value.coefficients, denominator: value.denominator, reason: value.reason, knowledge_ids: value.knowledge_ids, knowledge_sources: value.knowledge_sources, ruos: ordered }
  }

  fn Constant(number: int) -> Poly {
    return Attach(Value([number, 0, 0, 0, 0, 0], 1), [], [], [], 10)
  }

  fn Variable() -> Poly {
    return Attach(Value([0, 1, 0, 0, 0, 0], 1), [], [], [], 11)
  }

  fn Degree(value: Poly) -> int {
    let index = 5
    while index >= 0 {
      if value.coefficients[index] != 0 {
        return index
      }
      index = index - 1
    }
    return 0
  }

  fn ProductCoefficient(x: Poly, y: Poly, target: int) -> int {
    let total = 0
    let index = 0
    while index <= target {
      total = total + x.coefficients[index] * y.coefficients[target - index]
      index = index + 1
    }
    return total
  }

  fn Combine(kind: int, x: Poly, y: Poly) -> Poly {
    if !x.valid {
      return x
    }
    if !y.valid {
      return y
    }
    let rule = Knowledge::KExpressionRule(kind)
    if rule == 0 {
      return Invalid("UNKNOWN_KNOWLEDGE")
    }
    if kind == 4 && Degree(x) + Degree(y) > 5 {
      return Invalid("DEGREE_LIMIT")
    }
    if kind == 5 && (Degree(y) != 0 || y.coefficients[0] == 0) {
      return Invalid("DIVISION_DOMAIN")
    }
    let output = []
    let index = 0
    while index < 6 {
      let coefficient = 0
      if kind == 2 {
        coefficient = x.coefficients[index] * y.denominator + y.coefficients[index] * x.denominator
      }
      if kind == 3 {
        coefficient = x.coefficients[index] * y.denominator - y.coefficients[index] * x.denominator
      }
      if kind == 4 {
        coefficient = ProductCoefficient(x, y, index)
      }
      if kind == 5 {
        coefficient = x.coefficients[index] * y.denominator
      }
      output = array.append(output, coefficient)
      index = index + 1
    }
    if kind == 2 || kind == 3 || kind == 4 {
      let value = Attach(Value(output, x.denominator * y.denominator), array.concat(x.knowledge_ids, y.knowledge_ids), array.concat(x.knowledge_sources, y.knowledge_sources), array.concat(x.ruos, y.ruos), rule)
      return Transition(value, x, y, value.ruos, rule)
    }
    if kind == 5 {
      let value = Attach(Value(output, x.denominator * y.coefficients[0]), array.concat(x.knowledge_ids, y.knowledge_ids), array.concat(x.knowledge_sources, y.knowledge_sources), array.concat(x.ruos, y.ruos), rule)
      return Transition(value, x, y, value.ruos, rule)
    }
    return Invalid("UNSUPPORTED_OPERATOR")
  }

  fn Power(base: Poly, exponent: int) -> Poly {
    if exponent < 0 || exponent > 5 {
      return Invalid("EXPONENT_LIMIT")
    }
    let output = Constant(1)
    let index = 0
    while index < exponent {
      output = Combine(4, output, base)
      if !output.valid {
        return output
      }
      index = index + 1
    }
    let value = Attach(output, base.knowledge_ids, base.knowledge_sources, base.ruos, 16)
    return Transition(value, base, Constant(exponent), value.ruos, 16)
  }

  // Node kinds: 0 integer, 1 x, 2 +, 3 -, 4 *, 5 /, 6 nonnegative power.
  pub fn PolyEvaluate(kinds: [int], values: [int], lefts: [int], rights: [int]) -> Poly {
    if kinds.length == 0 || kinds.length > 64 || values.length != kinds.length || lefts.length != kinds.length || rights.length != kinds.length {
      return Invalid("INVALID_INPUT")
    }
    let terms = []
    let index = 0
    while index < kinds.length {
      let kind = kinds[index]
      let current = Invalid("INVALID_INPUT")
      let operation_ru = Knowledge::KRuByRule(Knowledge::KExpressionRule(kind))
      if operation_ru.id == 0 {
        return Invalid("UNKNOWN_KNOWLEDGE")
      }
      if kind == 0 {
        current = Constant(values[index])
      }
      if kind == 1 {
        current = Variable()
      }
      if kind >= 2 && kind <= 5 {
        let left = lefts[index]
        let right = rights[index]
        if left >= 0 && left < index && right >= 0 && right < index {
          current = Combine(kind, terms[left], terms[right])
        }
      }
      if kind == 6 {
        let left = lefts[index]
        if left >= 0 && left < index {
          current = Power(terms[left], values[index])
        }
      }
      terms = array.append(terms, current)
      index = index + 1
    }
    return Renumber(terms[terms.length - 1])
  }

  pub fn PolyDifferentiate(value: Poly) -> Poly {
    if !value.valid {
      return value
    }
    let coefficients = []
    let index = 1
    while index < 6 {
      coefficients = array.append(coefficients, value.coefficients[index] * index)
      index = index + 1
    }
    coefficients = array.append(coefficients, 0)
    let output = Attach(Value(coefficients, value.denominator), value.knowledge_ids, value.knowledge_sources, value.ruos, 17)
    return Transition(output, value, Constant(0), output.ruos, 17)
  }

  pub fn PolyIntegrate(value: Poly) -> Poly {
    if !value.valid {
      return value
    }
    if value.coefficients[5] != 0 {
      return Invalid("DEGREE_LIMIT")
    }
    let divisor = value.denominator * 60
    let coefficients = [0]
    let index = 0
    while index < 5 {
      coefficients = array.append(coefficients, value.coefficients[index] * DivideExact(60, index + 1))
      index = index + 1
    }
    let output = Attach(Value(coefficients, divisor), value.knowledge_ids, value.knowledge_sources, value.ruos, 18)
    return Transition(output, value, Constant(0), output.ruos, 18)
  }

  pub fn PolyCheckExpressions(before: Poly, after: Poly) -> Assessment {
    let item = Knowledge::KByRule(19)
    let active = Knowledge::KActiveOperationRus(19)
    let status = PolyAssessExpressions(before, after)
    let instance = AssessmentRuo { id: 1, source_ru: item.rule, source_rus: active.name, knowledge_id: item.id, source: item.source, validation: status }
    return Assessment { status: status, knowledge_id: item.id, source: item.source, active_rus: active.name, ruo: instance }
  }

  pub fn PolyCheckEquations(left: Poly, right: Poly, next_left: Poly, next_right: Poly) -> Assessment {
    let item = Knowledge::KByRule(20)
    let active = Knowledge::KActiveOperationRus(20)
    let status = PolyAssessEquations(left, right, next_left, next_right)
    let instance = AssessmentRuo { id: 1, source_ru: item.rule, source_rus: active.name, knowledge_id: item.id, source: item.source, validation: status }
    return Assessment { status: status, knowledge_id: item.id, source: item.source, active_rus: active.name, ruo: instance }
  }

  pub fn PolyAssessExpressions(before: Poly, after: Poly) -> string {
    if !before.valid || !after.valid {
      return "UNVERIFIED"
    }
    if before.denominator != after.denominator {
      return "INVALID"
    }
    let index = 0
    while index < 6 {
      if before.coefficients[index] != after.coefficients[index] {
        return "INVALID"
      }
      index = index + 1
    }
    return "VALID"
  }

  pub fn PolyAssessEquations(left: Poly, right: Poly, next_left: Poly, next_right: Poly) -> string {
    if !left.valid || !right.valid || !next_left.valid || !next_right.valid {
      return "UNVERIFIED"
    }
    let first = Combine(3, left, right)
    let second = Combine(3, next_left, next_right)
    if !first.valid || !second.valid {
      return "UNVERIFIED"
    }
    if Degree(first) <= 1 && Degree(second) <= 1 {
      if first.denominator != 1 || second.denominator != 1 {
        let a = first.coefficients[1] * second.denominator
        let b = first.coefficients[0] * second.denominator
        let c = second.coefficients[1] * first.denominator
        let d = second.coefficients[0] * first.denominator
        if Abs(a) > 1000000 || Abs(b) > 1000000 || Abs(c) > 1000000 || Abs(d) > 1000000 {
          return "UNVERIFIED"
        }
        return Model::AssessEquations(a, b, 0, 0, c, d, 0, 0)
      }
      return Model::AssessEquations(first.coefficients[1], first.coefficients[0], 0, 0, second.coefficients[1], second.coefficients[0], 0, 0)
    }
    // Proportional polynomials have identical zero sets. Other pairs need a
    // root-set proof; coefficient inequality alone cannot reject them.
    let anchor = -1
    let index = 0
    while index < 6 {
      if first.coefficients[index] != 0 || second.coefficients[index] != 0 {
        anchor = index
        break
      }
      index = index + 1
    }
    if anchor < 0 {
      return "VALID"
    }
    if first.coefficients[anchor] == 0 || second.coefficients[anchor] == 0 {
      return "UNVERIFIED"
    }
    index = 0
    while index < 6 {
      if first.coefficients[index] * second.coefficients[anchor] != second.coefficients[index] * first.coefficients[anchor] {
        return "UNVERIFIED"
      }
      index = index + 1
    }
    return "VALID"
  }

  pub fn PolySolveEquation(left: Poly, right: Poly) {
    if !left.valid || !right.valid {
      return Model::StatusOutcome("UNSUPPORTED")
    }
    let difference = Combine(3, left, right)
    if !difference.valid {
      return Model::StatusOutcome("RESOURCE_LIMIT")
    }
    if Degree(difference) > 1 {
      return Model::StatusOutcome("UNSOLVED")
    }
    if Degree(left) <= 1 && Degree(right) <= 1 {
      return Model::Solve(left.coefficients[1] * right.denominator, left.coefficients[0] * right.denominator, right.coefficients[1] * left.denominator, right.coefficients[0] * left.denominator)
    }
    return Model::Solve(difference.coefficients[1], difference.coefficients[0], 0, 0)
  }
}
