  let mut records : Array Json := #[]
  for name in names do
    let ci ← getConstInfo name
    let (statement, binders, conclusion) ← liftTermElabM do
      let statement := (← Meta.ppExpr ci.type).pretty
      Meta.forallTelescope ci.type fun xs body => do
        let mut bs : Array Json := #[]
        for x in xs do
          let d ← x.fvarId!.getDecl
          let tp := (← Meta.ppExpr d.type).pretty
          let prop ← Meta.isProp d.type
          bs := bs.push (Json.mkObj [("name",toJson d.userName.toString),
            ("type",toJson tp),("is_proposition",toJson prop),
            ("is_typeclass",toJson d.binderInfo.isInstImplicit)])
        return (statement,bs,(← Meta.ppExpr body).pretty)
    let axioms ← Lean.collectAxioms name
    let dependencies := ci.type.getUsedConstants ++ (ci.value?.map Expr.getUsedConstants |>.getD #[])
    records := records.push (Json.mkObj [("name",toJson name.toString),
      ("statement",toJson statement),("binders",toJson binders),("conclusion",toJson conclusion),
      ("axioms",toJson (axioms.map Name.toString)),
      ("direct_dependencies",toJson (dependencies.map Name.toString))])
  liftIO <| IO.FS.writeFile "verification/lean_knowledge_audit.json" (toJson records).pretty
